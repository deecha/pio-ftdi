;
; jtag.pio - single-SM JTAG shifter
;
; One program, two PINCTRL configurations (swapped from C):
;
;   DATA mode:  OUT = TDI,  SET = TMS,  IN = TDO,  SIDESET = TCK
;   TMS  mode:  OUT = TMS,  SET = TDI,  IN = TDO,  SIDESET = TCK
;
; Only one SM is ever used. That is deliberate: within a PIO block the
; higher-numbered SM wins a contested output pin even while disabled, so two
; SMs sharing TCK would fight. Swapping PINCTRL is one register write and we
; serialise every transaction anyway.
;
; FIFO protocol per transaction:
;   TX word 0 : nbits - 1        (1..32 bits per transaction)
;   TX word 1 : data, LSB first  (drives TDI in DATA mode, TMS in TMS mode)
;   RX word 0 : TDO, shifted right -- right-align with >> (32 - nbits)
;
; Edge behaviour matches what OpenOCD and Efinity actually emit
; (MPSSE 0x19/0x39/0x3B/0x4B/0x6B): output changes on the falling edge of TCK,
; TDO is sampled just before the rising edge.
;
; TIMING, THE HARD-WON PART. PIO GPIO inputs pass through a 2-cycle
; synchroniser, so `in pins` reads the pin as it was 2 cycles ago. Sampling too
; early costs a whole bit: the scan comes back offset by one, with a spurious
; leading 1 picked up from the TDO pull-up before the target drives.
;
; A real FTDI raises TCK and samples a few instructions later -- i.e. clearly
; after the rising edge, not on it. Match that: 12 cycles, 50% duty, with the
; read landing mid-high-phase.  TCK = clk_sys / (12 * clkdiv).
;
.program jtag_shift
.side_set 1

.wrap_target
    pull  block           side 0        ; word 0 -> OSR
    out   x, 32           side 0        ; X = nbits - 1
    pull  block           side 0        ; word 1 -> OSR (data)
bitloop:
    out   pins, 1         side 0 [5]    ; cyc 1-6:  TCK low, TDI/TMS updated at cyc 1
    nop                   side 1 [3]    ; cyc 7-10: TCK high, rising edge at cyc 7
    in    pins, 1         side 1        ; cyc 11:   +2-cycle synchroniser => reads
                                        ;   the pin as it was at cyc 9, mid-high,
                                        ;   well AFTER the rising edge
    jmp   x--, bitloop    side 1        ; cyc 12:   TCK high
    push  block           side 0        ; TCK returns low, hand back TDO
.wrap